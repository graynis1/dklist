{
  "expo": {
    "name": "DKList",
    "slug": "dklist",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dklist",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon-ios.png",
      "bundleIdentifier": "com.dklist.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "youtube"
        ],
        "CFBundleDevelopmentRegion": "tr"
      }
    },
    "android": {
      "package": "com.dklist.app",
      "adaptiveIcon": {
        "backgroundColor": "#f5eee4",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f5eee4",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#b68235"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Gönderi, blog ve ilanlarına fotoğraf eklemek için galerine erişim gerekiyor.",
          "cameraPermission": "Kitapların barkodunu okumak ve gönderine fotoğraf çekmek için kamera erişimi gerekiyor.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Kitapların barkodunu okumak ve gönderine fotoğraf çekmek için kamera erişimi gerekiyor.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
