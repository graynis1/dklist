# Copy to .env.local and adjust for your setup.
#
# Simulator/emulator can reach your computer's own localhost directly.
# A physical device (Expo Go on a real phone) cannot - use your machine's
# LAN IP instead (e.g. http://192.168.1.23:3000), same network as the phone.
# Points at v2's dev server (`cd v2 && npm run dev`, default port 3000).
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
